{
  "name": "taller3-parry-duel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Prototipo de juego de reacción y ritmo centrado en la mecánica de Parry (Phaser 3 + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "publish:pages": "npm run build && node scripts/publish-root.mjs",
    "dev:twinus": "vite --config vite.twinus.config.ts",
    "build:twinus": "tsc --noEmit && vite build --config vite.twinus.config.ts",
    "build:site": "npm run build:twinus && node scripts/build-site.mjs",
    "preview:site": "vite preview --outDir dist-site --port 4173 --strictPort"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
